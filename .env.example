# Zugangsdaten für Supabase.
# 1. Diese Datei kopieren und die Kopie ".env" nennen (ohne .example).
# 2. Beide Werte aus dem Supabase-Dashboard eintragen:
#    Project Settings -> API Keys -> "Project URL" und "Publishable key"
# Die .env wandert nie ins Git-Repository.
VITE_SUPABASE_URL=https://DEIN-PROJEKT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_XXXXXXXX
