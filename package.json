{
  "name": "wessamedia-zeit",
  "productName": "wessamedia Zeit",
  "version": "1.0.22",
  "description": "Zeiterfassung für wessamedia: automatisch am Rechner, von Hand für alles andere.",
  "private": true,
  "main": "./out/main/index.js",
  "author": "wessamedia",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json --composite false && tsc --noEmit -p tsconfig.web.json --composite false",
    "icon": "node scripts/icon-erzeugen.mjs",
    "build:unpack": "electron-vite build && electron-builder --dir",
    "build:win": "electron-vite build && electron-builder --win",
    "build:mac:app": "electron-vite build && electron-builder --mac --universal --dir",
    "build:mac": "electron-vite build && electron-builder --mac --universal"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.116.0",
    "electron-updater": "^6.8.9",
    "get-windows": "9.3.0"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "3.0.2",
    "@electron-toolkit/tsconfig": "2.0.0",
    "@electron-toolkit/utils": "4.0.0",
    "@fontsource-variable/inter": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "5.0.0",
    "lucide-react": "1.43.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "3.10.1",
    "simple-icons": "^16.30.0",
    "simple-icons-13": "npm:simple-icons@^13.21.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  }
}
